# HER LIFE — Environment Configuration Example

# Backend Settings
PORT=8001
HOST=0.0.0.0
DATABASE_URL=sqlite:///./backend/data/her_life.db
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Settings (Vite)
VITE_API_URL=http://localhost:8001/api

# Safety & Compliance Flags
DEMO_MODE=true
REQUIRE_CONSENT=true
ENABLE_DISCRETE_NOTIFICATIONS=true
